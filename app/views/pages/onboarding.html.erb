<% content_for :title, "Onboarding Guide" %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Welcome to Trello</h1>

  <div class="space-y-8">
    <div class="flex items-start gap-4">
      <div class="w-8 h-8 bg-gray-800 text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">1</div>
      <div>
        <h2 class="font-semibold text-gray-900">Create a Board</h2>
        <p class="text-sm text-gray-600 mt-1">Start by creating a board for your project. Think of it as a workspace for everything you need to track.</p>
        <%= link_to "Create Board", new_board_path, class: "inline-block mt-2 text-sm bg-gray-800 text-white px-3 py-1.5 rounded hover:bg-gray-700" %>
      </div>
    </div>

    <div class="flex items-start gap-4">
      <div class="w-8 h-8 bg-gray-800 text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">2</div>
      <div>
        <h2 class="font-semibold text-gray-900">Add Lists</h2>
        <p class="text-sm text-gray-600 mt-1">Inside your board, add lists to represent stages of work. Common examples: To Do, In Progress, Review, Done.</p>
      </div>
    </div>

    <div class="flex items-start gap-4">
      <div class="w-8 h-8 bg-gray-800 text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">3</div>
      <div>
        <h2 class="font-semibold text-gray-900">Add Cards</h2>
        <p class="text-sm text-gray-600 mt-1">Cards are your tasks. Add them to lists, give them titles, and optionally add descriptions for more detail.</p>
      </div>
    </div>

    <div class="flex items-start gap-4">
      <div class="w-8 h-8 bg-gray-800 text-white rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">4</div>
      <div>
        <h2 class="font-semibold text-gray-900">Drag & Drop</h2>
        <p class="text-sm text-gray-600 mt-1">Move cards between lists by dragging them. This updates their status instantly.</p>
      </div>
    </div>

    <div class="bg-gray-200 rounded-lg p-4 mt-6">
      <p class="text-sm text-gray-700">You're all set! Start by creating your first board.</p>
      <%= link_to "Go to Dashboard", root_path, class: "inline-block mt-2 text-sm bg-gray-800 text-white px-4 py-2 rounded hover:bg-gray-700" %>
    </div>
  </div>
</div>