<% content_for :title, @card.title %>

<div class="max-w-2xl mx-auto px-4 py-8">
  <%= link_to "← Back to #{@card.list.board.name}", board_path(@card.list.board), class: "text-sm text-gray-500 hover:text-gray-700 mb-4 inline-block" %>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-start justify-between mb-4">
      <h1 class="text-xl font-bold text-gray-900"><%= @card.title %></h1>
      <div class="flex gap-2">
        <%= link_to edit_board_card_path(@card.list.board, @card), class: "text-sm text-gray-400 hover:text-gray-600" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
        <% end %>
        <%= link_to [@card.list.board, @card], data: { turbo_method: :delete, turbo_confirm: "Delete this card?" }, class: "text-sm text-gray-400 hover:text-red-500" do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
          </svg>
        <% end %>
      </div>
    </div>

    <% if @card.description.present? %>
      <p class="text-gray-600 text-sm mb-4"><%= @card.description %></p>
    <% end %>

    <div class="flex flex-wrap gap-4 text-xs text-gray-500 mb-4">
      <span>List: <strong><%= @card.list.name %></strong></span>
      <% if @card.assignee.present? %>
        <span>Assignee: <strong><%= @card.assignee %></strong></span>
      <% end %>
      <% if @card.deadline.present? %>
        <span>Deadline: <strong><%= @card.deadline.to_fs(:long) %></strong></span>
      <% end %>
    </div>

    <% if @card.tags.any? %>
      <div class="flex flex-wrap gap-1 mb-4">
        <% @card.tags.each do |tag| %>
          <span class="bg-gray-100 text-gray-600 text-xs px-2 py-0.5 rounded"><%= tag.name %></span>
        <% end %>
      </div>
    <% end %>

    <div class="border-t border-gray-100 pt-4 mt-4">
      <h2 class="text-sm font-semibold text-gray-700 mb-3">Comments</h2>
      <% @card.comments.each do |comment| %>
        <div class="bg-gray-50 rounded p-3 mb-2 text-sm text-gray-700 flex justify-between items-start">
          <span><%= comment.body %></span>
          <%= link_to [@card.list.board, @card, comment], data: { turbo_method: :delete, turbo_confirm: "Delete comment?" }, class: "text-xs text-gray-300 hover:text-red-500 ml-2" do %>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          <% end %>
        </div>
      <% end %>
      <%= form_with model: [@card.list.board, @card, @comment], class: "flex gap-2 mt-3" do |f| %>
        <%= f.text_field :body, placeholder: "Add a comment...", class: "flex-1 border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400" %>
        <%= f.submit "Comment", class: "bg-gray-700 text-white px-3 py-1.5 rounded text-sm hover:bg-gray-600" %>
      <% end %>
    </div>
  </div>
</div>