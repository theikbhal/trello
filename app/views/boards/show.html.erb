<% content_for :title, @board.name %>

<div class="bg-gray-900 text-white px-4 py-3 flex items-center justify-between">
  <div class="flex items-center gap-3">
    <%= link_to root_path, class: "text-gray-300 hover:text-white" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="font-semibold"><%= @board.name %></h1>
    <%= link_to edit_board_path(@board), class: "text-gray-300 hover:text-white" do %>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
      </svg>
    <% end %>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to export_board_path(@board, format: :json), class: "text-xs text-gray-300 hover:text-white flex items-center gap-1", target: "_blank" do %>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Export
    <% end %>
  </div>
</div>

<div class="flex gap-3 overflow-x-auto p-4 h-[calc(100vh-10rem)] items-start" data-board-id="<%= @board.id %>" data-controller="boardsort">
  <% @lists.each do |list| %>
    <div class="bg-gray-200 rounded-lg w-72 flex-shrink-0 max-h-full flex flex-col" data-controller="list" data-list-id="<%= list.id %>" data-board-sort-target="list">
      <div class="px-3 py-2 flex items-center justify-between">
        <h2 class="font-semibold text-sm text-gray-800"><%= list.name %></h2>
        <div class="flex items-center gap-1">
          <%= link_to edit_board_list_path(@board, list), class: "text-gray-400 hover:text-gray-600" do %>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
          <% end %>
          <%= link_to [@board, list], data: { turbo_method: :delete, turbo_confirm: "Delete this list and all its cards?" } do %>
            <svg class="w-3.5 h-3.5 text-gray-400 hover:text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          <% end %>
        </div>
      </div>
      <div class="flex-1 overflow-y-auto px-2 pb-2 space-y-2" data-list-target="cards" data-list-id="<%= list.id %>">
        <% list.cards.each do |card| %>
          <%= link_to board_card_path(@board, card), class: "block bg-white rounded shadow-sm p-3 text-sm group hover:shadow-md transition-shadow" do %>
            <div class="flex justify-between items-start gap-2">
              <span class="text-gray-800 font-medium"><%= card.title %></span>
            </div>
            <% if card.description.present? %>
              <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= card.description %></p>
            <% end %>
            <div class="flex flex-wrap items-center gap-2 mt-2">
              <% if card.assignee.present? %>
                <span class="text-xs bg-blue-50 text-blue-600 px-1.5 py-0.5 rounded flex items-center gap-1">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                  </svg>
                  <%= card.assignee %>
                </span>
              <% end %>
              <% if card.deadline.present? %>
                <span class="text-xs <%= card.deadline < Time.current ? 'bg-red-50 text-red-600' : 'bg-gray-50 text-gray-500' %> px-1.5 py-0.5 rounded flex items-center gap-1">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <%= card.deadline.to_fs(:short) %>
                </span>
              <% end %>
            </div>
            <% if card.tags.any? %>
              <div class="flex flex-wrap gap-1 mt-1.5">
                <% card.tags.each do |tag| %>
                  <span class="bg-gray-100 text-gray-500 text-xs px-1.5 py-0.5 rounded"><%= tag.name %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <div class="px-2 pb-2">
        <%= form_with url: board_cards_path(@board, list_id: list.id), class: "flex gap-1" do |f| %>
          <%= f.text_field :title, name: "card[title]", placeholder: "+ Add card", class: "w-full border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-gray-400" %>
          <%= f.submit "Add", class: "bg-gray-700 text-white px-2 py-1 rounded text-xs hover:bg-gray-600" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="bg-gray-200 rounded-lg w-72 flex-shrink-0">
    <%= form_with model: [@board, @board.lists.new], class: "p-2" do |f| %>
      <%= f.text_field :name, placeholder: "+ Add list", class: "w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400" %>
      <%= f.submit "Add List", class: "mt-2 bg-gray-800 text-white px-3 py-1 rounded text-xs hover:bg-gray-700" %>
    <% end %>
  </div>
</div>