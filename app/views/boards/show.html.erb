<% content_for :title, @board.name %>

<div class="bg-gray-900 text-white px-4 py-3 flex items-center justify-between">
  <div class="flex items-center gap-4">
    <h1 class="font-semibold"><%= @board.name %></h1>
    <%= link_to "Edit", edit_board_path(@board), class: "text-xs text-gray-300 hover:text-white" %>
  </div>
  <%= link_to "Dashboard", root_path, class: "text-xs text-gray-300 hover:text-white" %>
</div>

<div class="flex gap-3 overflow-x-auto p-4 h-[calc(100vh-8rem)] items-start" data-board-id="<%= @board.id %>">
  <% @board.lists.each do |list| %>
    <div class="bg-gray-200 rounded-lg w-72 flex-shrink-0 max-h-full flex flex-col" data-controller="list" data-list-id="<%= list.id %>">
      <div class="px-3 py-2 flex items-center justify-between">
        <h2 class="font-semibold text-sm text-gray-800"><%= list.name %></h2>
        <div class="flex gap-1">
          <%= link_to "✕", [@board, list], data: { turbo_method: :delete, turbo_confirm: "Delete this list?" }, class: "text-xs text-gray-400 hover:text-red-500" %>
        </div>
      </div>
      <div class="flex-1 overflow-y-auto px-2 pb-2 space-y-2" data-list-target="cards" data-list-id="<%= list.id %>">
        <% list.cards.each do |card| %>
          <div class="bg-white rounded shadow-sm p-3 text-sm group" draggable="true" data-card-id="<%= card.id %>">
            <div class="flex justify-between items-start">
              <span class="text-gray-800"><%= card.title %></span>
              <%= link_to "✕", [@board, card], data: { turbo_method: :delete, turbo_confirm: "Delete this card?" }, class: "text-xs text-gray-300 hover:text-red-500 opacity-0 group-hover:opacity-100" %>
            </div>
            <% if card.description.present? %>
              <p class="text-xs text-gray-500 mt-1"><%= card.description %></p>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="px-2 pb-2">
        <%= form_with model: [@board, list, Card.new], class: "flex gap-1" do |f| %>
          <%= f.text_field :title, placeholder: "+ Add card", class: "w-full border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-gray-400" %>
          <%= f.submit "Add", class: "bg-gray-700 text-white px-2 py-1 rounded text-xs hover:bg-gray-600" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="bg-gray-200 rounded-lg w-72 flex-shrink-0">
    <%= form_with model: [@board, @board.lists.new], class: "p-2" do |f| %>
      <%= f.text_field :name, placeholder: "+ Add list", class: "w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400" %>
      <%= f.submit "Add List", class: "mt-2 bg-gray-800 text-white px-3 py-1 rounded text-xs hover:bg-gray-700" %>
    <% end %>
  </div>
</div>