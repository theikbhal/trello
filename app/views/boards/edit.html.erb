<div class="max-w-lg mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Board</h1>
  <%= form_with model: @board, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-400" %>
    </div>
    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-400" %>
    </div>
    <div class="flex gap-3">
      <%= f.submit "Update", class: "bg-gray-800 text-white px-4 py-2 rounded text-sm hover:bg-gray-700" %>
      <%= link_to "Cancel", @board, class: "text-sm text-gray-500 px-4 py-2 hover:text-gray-700" %>
    </div>
  <% end %>
</div>